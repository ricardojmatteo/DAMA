# Copie para .env para alterar credenciais ou portas do docker-compose.
DB_NAME=dama
DB_USER=dama
DB_PASSWORD=dama

DB_PORTA=5432
BACKEND_PORTA=8080
FRONTEND_PORTA=3000
ALERTAS_PORTA=4000

# Segredo do token de acesso (mínimo de 32 caracteres). Obrigatório fora do ambiente de desenvolvimento.
DAMA_JWT_SEGREDO=

# Assistente IA (página "Assistente IA"): chave da API da Anthropic (console.anthropic.com). Nunca faça commit do .env.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-sonnet-5-5
