# Copie para .env para alterar credenciais ou portas do docker-compose.
DB_NAME=dama
DB_USER=dama
DB_PASSWORD=dama

DB_PORTA=5432
BACKEND_PORTA=8080
FRONTEND_PORTA=3000
ALERTAS_PORTA=4000

# Segredo do token de acesso (mínimo de 32 caracteres). Obrigatório fora do ambiente de desenvolvimento.
DAMA_JWT_SEGREDO=

# Assistente IA (aba "Assistente IA"): chave da API da OpenAI (platform.openai.com/api-keys). Nunca faça commit do .env.
OPENAI_API_KEY=
# OPENAI_MODELO=gpt-6-luna
# OPENAI_ESFORCO=low
